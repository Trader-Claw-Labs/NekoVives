# systemd unit for nv-runner (Fase 1, docs/VPS_EXECUTION_PLAN.md)
#
# Install on the VPS:
#   scp target/release/nv-runner  vps:/opt/nv/nv-runner          (build local — la VPS de 4GB no compila Rust)
#   scp scripts/deploy/nv-runner.rewards_maker.example.json vps:/opt/nv/runner.json
#   create /opt/nv/nv-runner.env with the POLY_* secrets (chmod 600, owner nv)
#   sudo cp nv-runner.service /etc/systemd/system/ && sudo systemctl enable --now nv-runner
#
# Logs:    journalctl -u nv-runner -f
# Stop:    systemctl stop nv-runner   (SIGTERM → cancela quotes resting antes de salir)

[Unit]
Description=Neko Vives headless strategy runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nv
WorkingDirectory=/opt/nv
EnvironmentFile=/opt/nv/nv-runner.env
ExecStart=/opt/nv/nv-runner --config /opt/nv/runner.json --workspace /opt/nv/workspace
Restart=on-failure
RestartSec=30
# rewards_maker necesita hasta 75s para cancelar quotes al apagar
TimeoutStopSec=90
# Hardening básico
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
